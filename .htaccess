# ==========================================================
# KAMINI CLINIC & LABS — site-wide Apache rules
# Read by Apache / LiteSpeed hosts (BigRock, cPanel). mail/ has
# its own .htaccess on top of this, which keeps config.php private.
# ==========================================================

# No folder ever shows a list of its files.
Options -Indexes

# A missing page gets the site's own not-found page.
ErrorDocument 404 /404.html

# The home page is home.html, so the bare domain (kaminilabs.in/)
# opens it. index.html stays second in line only as a fallback.
DirectoryIndex home.html index.html

# The pages were once index.html and about.html. Old links, bookmarks
# and search results are sent on to the new names for good (301), with
# any ?query kept. The condition captures the folder the site sits in,
# so the redirect also works from a sub-folder (e.g. a local XAMPP copy).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Every visit to the live site is over https. Only on kaminilabs.in
  # (with or without www), so a local copy on http://localhost is left
  # alone; the forwarded-proto check stops a loop behind a proxy.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} ^(www\.)?kaminilabs\.in$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  RewriteCond %{REQUEST_URI} ^(.*/)index\.html$
  RewriteRule ^index\.html$ %1home.html [R=301,L]
  RewriteCond %{REQUEST_URI} ^(.*/)about\.html$
  RewriteRule ^about\.html$ %1aboutus.html [R=301,L]
</IfModule>

# File types the server does not always know. Without a type a
# browser downloads the file instead of opening it.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddCharset utf-8 .html .css .js .svg .xml .txt .webmanifest
</IfModule>

# Project notes and hidden files are not part of the website:
# README.md, .gitignore, .htaccess and the like are refused.
<FilesMatch "(^\.|\.md$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Version-control folders, should one ever be uploaded by mistake.
<IfModule mod_alias.c>
  RedirectMatch 404 /\.(git|svn|hg)(/|$)
</IfModule>

# Standard protective headers.
#   nosniff         a file is only ever treated as the type it is sent as
#   SAMEORIGIN      other sites cannot show these pages inside a frame
#   Referrer-Policy other sites see only the domain a visitor came from
#   Permissions     the site never asks for camera, microphone or location
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
